    <!-- Adaptive-icon background. #004136 == the 5B launcher artwork's
         own field colour, so the foreground/background seam is invisible.
         (Changed from #005A45 with the 5A/5B icon install, 2026-11-18.) -->
    <color name="ic_launcher_background">#004136</color>
</resources>
